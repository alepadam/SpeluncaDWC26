# ---- Secrets: never commit ----
.env
.env.*
!.env.example

# ---- Competition data: must not be published (DWC26 rule) ----
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# dataset folder kept inside the project (e.g. C:/SpeluncaDWC26/Dataset) and any competition file anywhere
Dataset/
dataset/
dwc26/
*.xlsx
*.xls
*.xlsm
*.pptx

# ---- Generated outputs (regenerated by notebooks/02_pipeline.ipynb) ----
outputs/*/*
!outputs/*/.gitkeep

# ---- Large deliverables: share via Drive / portal, not git ----
*.zip
*.pbix
*.mp4

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.joblib

# ---- Office / OS ----
~$*
.DS_Store
Thumbs.db
